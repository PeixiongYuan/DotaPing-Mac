<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotaPing.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated on macOS with the export-glyphs option of the DotaPing app (see Glyphs.cs). -->
    <EmbeddedResource Include="glyphs.json" LogicalName="DotaPing.glyphs.json" />
  </ItemGroup>

</Project>
